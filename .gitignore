node_modules/
dist/
build/
coverage/
*.log
# Convention Symfony : `.env` EST versionné — il ne porte que des valeurs par
# défaut, sans secret. Les vraies valeurs vivent dans `.env.local`, ignoré.
# Sans `.env` dans le dépôt, un déploiement par `git clone` échoue au démarrage.
.env.local
.env.*.local
.DS_Store
packages/server/uploads/
packages/server/test-uploads/
packages/web/dev-dist/

# Le canevas assemblé des maquettes : 2,4 Mo d'éditeur empaqueté, reconstruit
# à la demande depuis les .dc.html voisins. Ce sont EUX les sources.
design/*.html
!design/*.dc.html
