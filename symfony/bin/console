#!/usr/bin/env php
<?php

use Merisu\Inventory\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

if (!is_dir(dirname(__DIR__) . '/vendor')) {
    throw new LogicException('Dépendances absentes : lancez "composer install".');
}

require_once dirname(__DIR__) . '/vendor/autoload_runtime.php';

return static fn (array $context): Application => new Application(
    new Kernel($context['APP_ENV'], (bool) $context['APP_DEBUG']),
);
