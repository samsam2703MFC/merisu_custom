{#
  Connexion ADMINISTRATION — porte d'entrée distincte de celle du poste.

  Volontairement sobre et sans rappel de codes : cet écran n'est pas destiné
  aux vendeurs, et rien n'y renvoie depuis l'application de comptage.
#}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'adminLogin.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}
{% block body_class %} app--centered{% endblock %}

{% block header %}{% endblock %}
{% block nav %}{% endblock %}

{% block content %}
  <section class="card card--login card--admin-login">
    <h1 class="login-logo"><img src="{{ asset('assets/logo.png') }}" alt="{{ 'common.appName'|trans }}"></h1>

    <p class="admin-login__eyebrow">{{ 'adminLogin.eyebrow'|trans }}</p>
    <p class="page-header__subtitle">{{ 'adminLogin.subtitle'|trans }}</p>

    {% if error %}
      <p class="banner banner--danger" role="alert">{{ ('errors.' ~ error)|trans }}</p>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}" class="form">
      {{ ui.pin_field('adminLogin.pincode'|trans, true) }}

      <button type="submit" class="button button--primary button--block button--large">
        {{ 'adminLogin.submit'|trans }}
      </button>
    </form>

    <hr class="separator">
    <p class="muted">
      <a href="{{ path('login') }}">{{ 'adminLogin.backToSeller'|trans }}</a>
    </p>

    {# La langue se choisit ici, au pied du formulaire. #}
    {{ ui.locale_flags(app.request.locale) }}
  </section>
{% endblock %}
