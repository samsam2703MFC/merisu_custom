{#
  Fiche profil — informations issues du module Consultant existant.

  Lecture seule : modifier ces données ici les ferait diverger du module
  d'origine. Seules la langue et le poste courant, qui relèvent de la session,
  se changent depuis cet écran.
#}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% set c = consultant %}

{% block title %}{{ 'profile.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block content %}

  <section class="card profile">
    <header class="profile__header">
      <span class="avatar avatar--lg" aria-hidden="true">{{ c.initials }}</span>

      <div class="profile__identity">
        <h1 class="profile__name">{{ c.displayName }}</h1>
        <p class="profile__role">
          {#
            Le rôle porte la MÊME couleur que dans la liste Équipe : prune pour
            l'admin, vert pour le manager. Un même rôle changeait de couleur
            d'un écran à l'autre — rouge ici, prune là-bas —, et deux teintes
            pour une seule chose font douter qu'il s'agisse de la même.
          #}
          {{ ui.badge(c.role.isAdmin ? 'info' : (c.role.isManager ? 'ok' : 'neutral'), ('roles.' ~ c.role.value)|trans) }}
        </p>
      </div>
    </header>

    <dl class="profile__fields">
      <div class="profile__field">
        <dt>{{ 'profile.firstName'|trans }}</dt>
        <dd>{{ c.firstName ?: '—' }}</dd>
      </div>

      <div class="profile__field">
        <dt>{{ 'profile.lastName'|trans }}</dt>
        <dd>{{ c.lastName ?: '—' }}</dd>
      </div>

      {% if c.email %}
        <div class="profile__field">
          <dt>{{ 'profile.email'|trans }}</dt>
          <dd><a href="mailto:{{ c.email }}">{{ c.email }}</a></dd>
        </div>
      {% endif %}

      {#
        Le code n'est jamais écrit en clair dans la page : la tablette reste
        posée au poste, à portée de n'importe qui. Le bouton révèle les
        chiffres à la demande, sans qu'ils transitent une seconde fois.
      #}
      {% if c.pin %}
        <div class="profile__field">
          <dt>{{ 'profile.pin'|trans }}</dt>
          <dd>
            <span class="profile__pin" data-pin-masked>{{ c.maskedPin }}</span>
            <span class="profile__pin" data-pin-clear hidden>{{ c.pin }}</span>
            <button type="button" class="button button--secondary button--small"
                    data-pin-toggle
                    data-label-show="{{ 'profile.pinShow'|trans }}"
                    data-label-hide="{{ 'profile.pinHide'|trans }}">
              {{ 'profile.pinShow'|trans }}
            </button>
          </dd>
        </div>
      {% endif %}

      {% if shopNames is not empty %}
        <div class="profile__field">
          <dt>{{ 'profile.shops'|trans }}</dt>
          {# Des NOMS, jamais « shop-5 » : l'identifiant interne ne dit rien à
             la personne qui se lit. Résolu dans le contrôleur. #}
          <dd>{{ shopNames|join(' · ') }}</dd>
        </div>
      {% endif %}

      <div class="profile__field">
        <dt>{{ 'profile.workstations'|trans }}</dt>
        <dd>{{ workstationNames is not empty ? workstationNames|join(' · ') : '—' }}</dd>
      </div>

      <div class="profile__field">
        <dt>{{ 'profile.currentWorkstation'|trans }}</dt>
        <dd>{{ currentWorkstation ?: '—' }}</dd>
      </div>

      <div class="profile__field">
        <dt>{{ 'profile.language'|trans }}</dt>
        <dd>{{ ('locales.' ~ app.request.locale)|trans }}</dd>
      </div>
    </dl>
  </section>

  {#
    Poste et langue ne se règlent plus ici : ils vivent dans le menu de
    l'avatar, atteignable depuis n'importe quel écran. Les dupliquer ferait
    deux endroits pour un seul réglage.
  #}
  <section class="card">
    <h2 class="card__title">{{ 'profile.preferences'|trans }}</h2>
    <p class="field__hint">{{ 'profile.preferencesHint'|trans }}</p>

    {% if c.locale and c.locale.value != app.request.locale %}
      <p class="field__hint">{{ 'profile.localeFromModule'|trans({ '%locale%': ('locales.' ~ c.locale.value)|trans }) }}</p>
    {% endif %}

    <p class="field__hint">{{ 'profile.readOnlyHint'|trans }}</p>
  </section>

{% endblock %}
