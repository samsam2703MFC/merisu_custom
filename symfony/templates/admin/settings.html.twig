{# §7.7 — Paramètres généraux : horaires, fuseau, langue, tolérance. #}
{% extends 'admin/_layout.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'admin.settings.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block admin_content %}

  {{ ui.page_header('admin.settings.title'|trans, 'admin.settings.subtitle'|trans) }}

  <section class="card">
    <form method="post" action="{{ path('admin_settings_save') }}" class="form">

      <div class="field-grid">
        <div class="field">
          <label class="field__label" for="openingTime">{{ 'admin.settings.openingTime'|trans }}</label>
          <input class="field__input" type="time" id="openingTime" name="openingTime"
                 value="{{ settings.openingTime }}">
        </div>

        <div class="field">
          <label class="field__label" for="closingTime">{{ 'admin.settings.closingTime'|trans }}</label>
          <input class="field__input" type="time" id="closingTime" name="closingTime"
                 value="{{ settings.closingTime }}">
        </div>

        <div class="field">
          <label class="field__label" for="timezone">{{ 'admin.settings.timezone'|trans }}</label>
          <input class="field__input" type="text" id="timezone" name="timezone"
                 value="{{ settings.timezone }}" placeholder="Europe/Warsaw" list="timezones">
          {# Un fuseau inconnu est refusé côté serveur : accepté, il fausserait
             silencieusement toutes les dates métier. #}
          <datalist id="timezones">
            {% for tz in ['Europe/Warsaw', 'Europe/Paris', 'Europe/Rome', 'Europe/Madrid', 'UTC'] %}
              <option value="{{ tz }}"></option>
            {% endfor %}
          </datalist>
        </div>

        <div class="field">
          <label class="field__label" for="defaultLocale">{{ 'admin.settings.defaultLocale'|trans }}</label>
          <select class="field__input" id="defaultLocale" name="defaultLocale">
            {% for locale in locales %}
              <option value="{{ locale.value }}" {{ locale == settings.defaultLocale ? 'selected' : '' }}>
                {{ ('locales.' ~ locale.value)|trans }}
              </option>
            {% endfor %}
          </select>
          <p class="field__hint">{{ 'admin.settings.defaultLocaleHint'|trans }}</p>
        </div>

        <div class="field">
          <label class="field__label" for="deltaTolerance">{{ 'admin.settings.deltaTolerance'|trans }}</label>
          <input class="field__input" type="number" min="0" step="0.01"
                 id="deltaTolerance" name="deltaTolerance" value="{{ settings.deltaTolerance }}">
          <p class="field__hint">{{ 'admin.settings.deltaToleranceHint'|trans }}</p>
        </div>

        {# Objectif de la jauge tiramisu de l'écran Réseau. Vide ou zéro : pas
           d'objectif, donc pas de jauge — plutôt qu'une barre sans repère. #}
        <div class="field">
          <label class="field__label" for="monthlyTiramisuTarget">
            {{ 'admin.settings.monthlyTiramisuTarget'|trans }}
          </label>
          <input class="field__input" type="number" min="0" step="1"
                 id="monthlyTiramisuTarget" name="monthlyTiramisuTarget"
                 value="{{ settings.monthlyTiramisuTarget }}">
          <p class="field__hint">{{ 'admin.settings.monthlyTiramisuTargetHint'|trans }}</p>
        </div>
      </div>

      {#
        Les réglages photo ne figurent plus ici : les photos ont été retirées
        des écrans de comptage. Un interrupteur qui ne commande plus rien est
        un piège pour qui l'actionne.
      #}

      <div class="form-actions">
        <button type="submit" class="button button--primary">{{ 'common.save'|trans }}</button>
      </div>
    </form>
  </section>

  {#
    État de la traduction assistée — en LECTURE seule.

    La clé ne se saisit pas ici, et c'est délibéré : un champ de saisie
    suppose un champ d'affichage, et l'écran d'administration deviendrait
    l'endroit d'où l'on relit une clé d'API. Elle vit côté serveur, où seul
    l'accès au serveur la livre.

    Mais l'état, lui, se dit : sans cette ligne, un administrateur qui ne
    trouve pas le bouton « Traduire » n'a aucun moyen de savoir s'il manque
    une clé ou s'il regarde au mauvais endroit.
  #}
  <section class="card">
    <div class="field">
      <span class="field__label">{{ 'admin.translate.state'|trans }}</span>

      {% if translation_available() %}
        {{ ui.badge('ok', 'admin.translate.enabled'|trans) }}
      {% else %}
        {{ ui.badge('warn', 'admin.translate.disabled'|trans) }}
      {% endif %}

      <p class="field__hint">{{ 'admin.translate.stateHint'|trans }}</p>
    </div>
  </section>

{% endblock %}
