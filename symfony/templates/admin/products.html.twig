{# §7.6 — Paramètres produits : les 8 emplacements, renommables et réglables. #}
{% extends 'admin/_layout.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'admin.products.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block admin_content %}

  {{ ui.page_header('admin.products.title'|trans, 'admin.products.subtitle'|trans) }}

  <div class="banner banner--warn">{{ 'admin.products.placeholderWarning'|trans }}</div>

  {# Partagée par tous les formulaires de la page : une seule liste suffit. #}
  <datalist id="product-categories">
    {% for name in categories %}<option value="{{ name }}"></option>{% endfor %}
  </datalist>

  {#
    Une fiche par produit, repliée par défaut.

    Onze champs par produit et huit produits : la page dépliée faisait plus de
    vingt écrans de haut sur téléphone, et atteindre le huitième produit
    demandait une minute de défilement. Repliée, elle tient sur un écran et
    demi, et l'on ouvre la seule fiche que l'on vient modifier.

    Bâti sur <details> : aucun script, donc le repli fonctionne aussi quand
    le réseau du poste n'a pas laissé passer app.js.
  #}
  {% for product in products %}
    <details class="card admin-item">
      <summary class="admin-item__summary">
        <span class="admin-item__head">
          {{ ui.badge('neutral', product.code) }}
          <span class="admin-item__name">{{ product_label(product) }}</span>
        </span>
        {% if not product.active %}
          {{ ui.badge('warn', 'admin.products.inactive'|trans) }}
        {% endif %}
      </summary>

      <form method="post" action="{{ path('admin_product_save', { id: product.id }) }}" class="form">

        <div class="checkbox-row">
          <input type="checkbox" id="active-{{ product.id }}" name="active" value="1"
                 {{ product.active ? 'checked' : '' }}>
          <label for="active-{{ product.id }}">{{ 'admin.products.active'|trans }}</label>
        </div>

        {# Un libellé par langue : ce sont des DONNÉES saisies ici, pas des
           chaînes d'interface (celles-ci vivent dans translations/). #}
        <div class="field-grid">
          {% for locale in supported_locales() %}
            <div class="field">
              <label class="field__label" for="name-{{ product.id }}-{{ locale.value }}">
                {{ 'admin.products.namePerLocale'|trans({ '%locale%': ('locales.' ~ locale.value)|trans }) }}
              </label>
              <input class="field__input" type="text"
                     id="name-{{ product.id }}-{{ locale.value }}"
                     name="name_{{ locale.value }}"
                     value="{{ product.name[locale.value] ?? '' }}">
            </div>
          {% endfor %}
        </div>

        <div class="field-grid">
          <div class="field">
            <label class="field__label" for="countMode-{{ product.id }}">{{ 'admin.products.countMode'|trans }}</label>
            <select class="field__input" id="countMode-{{ product.id }}" name="countMode">
              {% for mode in countModes %}
                <option value="{{ mode.value }}" {{ mode == product.countMode ? 'selected' : '' }}>
                  {{ ('admin.products.countModes.' ~ mode.value)|trans }}
                </option>
              {% endfor %}
            </select>
            <p class="field__hint">{{ 'admin.products.countModeHint'|trans }}</p>
          </div>

          <div class="field">
            <label class="field__label" for="unit-{{ product.id }}">{{ 'admin.products.unit'|trans }}</label>
            <input class="field__input" type="text" id="unit-{{ product.id }}"
                   name="unit" value="{{ product.unit }}">
          </div>

          {# Catégorie de production, en texte libre : elle sert à filtrer
             l'écran « À produire ». La liste proposée est celle déjà utilisée
             ailleurs, pour éviter deux orthographes d'une même catégorie. #}
          <div class="field">
            <label class="field__label" for="category-{{ product.id }}">
              {{ 'admin.products.category'|trans }}
            </label>
            <input class="field__input" type="text" id="category-{{ product.id }}"
                   name="category" value="{{ product.category }}" maxlength="64"
                   list="product-categories">
            <p class="field__hint">{{ 'admin.products.categoryHint'|trans }}</p>
          </div>

          <div class="field">
            <label class="field__label" for="waste-{{ product.id }}">
              {{ 'admin.products.wasteFactor'|trans }}
            </label>
            <input class="field__input" type="number" min="0" step="0.01"
                   id="waste-{{ product.id }}" name="wasteFactor" value="{{ product.wasteFactor }}">
            <p class="field__hint">{{ 'admin.products.wasteFactorHint'|trans }}</p>
          </div>

          <div class="field">
            <label class="field__label" for="step-{{ product.id }}">
              {{ 'admin.products.roundingStep'|trans }}
            </label>
            <input class="field__input" type="number" min="0.001" step="0.001"
                   id="step-{{ product.id }}" name="roundingStep" value="{{ product.roundingStep }}">
            <p class="field__hint">{{ 'admin.products.roundingStepHint'|trans }}</p>
          </div>

          <div class="field">
            <label class="field__label" for="mode-{{ product.id }}">
              {{ 'admin.products.roundingMode'|trans }}
            </label>
            <select class="field__input" id="mode-{{ product.id }}" name="roundingMode">
              {% for mode in roundingModes %}
                <option value="{{ mode.value }}" {{ mode == product.roundingMode ? 'selected' : '' }}>
                  {{ ('admin.roundingMode.' ~ mode.value)|trans }}
                </option>
              {% endfor %}
            </select>
          </div>

          {# Clé de pont vers le module « Recette technique » existant. #}
          <div class="field">
            <label class="field__label" for="recipe-{{ product.id }}">
              {{ 'admin.products.recipeRef'|trans }}
            </label>
            <input class="field__input" type="text" id="recipe-{{ product.id }}"
                   name="recipeRef" value="{{ product.recipeRef ?? '' }}">
            <p class="field__hint">{{ 'admin.products.recipeRefHint'|trans }}</p>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="button button--primary">{{ 'common.save'|trans }}</button>
        </div>
      </form>
    </details>
  {% endfor %}

{% endblock %}
