{#
  §7.5 — Stock minimum, en deux onglets.

  Deux populations, deux façons d'obtenir un minimum — d'où deux onglets, et
  non un tableau unique où l'on ne saurait plus lequel gouverne :

  · une MATIÈRE PREMIÈRE s'achète. Son minimum est un SEUIL que l'atelier pose,
    produit par produit et jour par jour. Rien ne peut le deviner : la
    consommation d'un sac de cacao ne dit pas combien il faut en avoir d'avance
    pour tenir jusqu'à la prochaine livraison ;
  · une COMPOSITION se fabrique. Son minimum se DÉDUIT de ce qui s'est écoulé
    les six derniers mêmes jours de semaine, corrigé par le temps attendu.
    Rien à saisir, et c'est précisément l'intérêt.

  Les onglets tiennent sur des boutons radio et `:checked ~`, comme ceux de la
  fiche produit : aucun script.
#}
{% extends 'admin/_layout.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'admin.parMatrix.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block admin_content %}

  {{ ui.page_header('admin.parMatrix.title'|trans, 'admin.parMatrix.subtitle'|trans) }}

  <div class="tabs">
    <input class="tabs__radio" type="radio" name="par-tab" id="par-tab-raw" checked>
    <input class="tabs__radio" type="radio" name="par-tab" id="par-tab-composed">

    <div class="tabs__bar">
      <label class="tabs__tab" for="par-tab-raw">
        {{ 'admin.parMatrix.tabs.raw'|trans }} <span class="muted">({{ rawProducts|length }})</span>
      </label>
      <label class="tabs__tab" for="par-tab-composed">
        {{ 'admin.parMatrix.tabs.composed'|trans }} <span class="muted">({{ composedProducts|length }})</span>
      </label>
    </div>

    {# ── Matières premières : des seuils que l'on POSE ───────────────────── #}
    <section class="tabs__panel">
      <div class="banner banner--info">{{ 'admin.parMatrix.rawHint'|trans }}</div>

      {% if rawProducts is empty %}
        {{ ui.banner('info', 'admin.parMatrix.noRaw'|trans) }}
      {% else %}
        <section class="card">
          <div class="card__header">
            <a class="button button--secondary"
               href="{{ path('admin_par_matrix', { orientation: productsInRows ? 'days' : 'products' }) }}">
              {{ (productsInRows ? 'admin.parMatrix.daysInRows' : 'admin.parMatrix.productsInRows')|trans }}
            </a>
          </div>

          <form method="post" action="{{ path('admin_par_matrix_save') }}">
            <div class="table-scroll">
              <table class="table table--matrix">
                {% if productsInRows %}
                  <thead>
                    <tr>
                      <th>{{ 'common.product'|trans }}</th>
                      {% for day in days %}<th>{{ ('daysShort.' ~ day.value)|trans }}</th>{% endfor %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for product in rawProducts %}
                      <tr>
                        <th scope="row">
                          {{ product_label(product) }}
                          {% if not product.active %}{{ ui.badge('warn', 'admin.products.inactive'|trans) }}{% endif %}
                        </th>
                        {% for day in days %}
                          <td class="table__cell--editable">
                            <input class="table__input" type="number" min="0" step="any" inputmode="numeric"
                                   name="par[{{ product.id }}][{{ day.value }}]"
                                   value="{{ values[product.id][day.value] ?? '' }}"
                                   aria-label="{{ product_label(product) }} — {{ ('days.' ~ day.value)|trans }}">
                          </td>
                        {% endfor %}
                      </tr>
                    {% endfor %}
                  </tbody>
                {% else %}
                  <thead>
                    <tr>
                      <th>{{ 'common.date'|trans }}</th>
                      {% for product in rawProducts %}<th>{{ product_label(product) }}</th>{% endfor %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for day in days %}
                      <tr>
                        <th scope="row">{{ ('days.' ~ day.value)|trans }}</th>
                        {% for product in rawProducts %}
                          <td class="table__cell--editable">
                            <input class="table__input" type="number" min="0" step="any" inputmode="numeric"
                                   name="par[{{ product.id }}][{{ day.value }}]"
                                   value="{{ values[product.id][day.value] ?? '' }}"
                                   aria-label="{{ product_label(product) }} — {{ ('days.' ~ day.value)|trans }}">
                          </td>
                        {% endfor %}
                      </tr>
                    {% endfor %}
                  </tbody>
                {% endif %}
              </table>
            </div>

            <div class="form-actions">
              <button type="submit" class="button button--primary">{{ 'common.save'|trans }}</button>
            </div>
          </form>
        </section>
      {% endif %}
    </section>

    {# ── Compositions : un minimum CALCULÉ ───────────────────────────────── #}
    <section class="tabs__panel">
      <div class="banner banner--info">{{ 'admin.parMatrix.composedHint'|trans }}</div>

      {#
        Le temps attendu, JOUR PAR JOUR.

        Un seul réglage pour les sept ne voudrait rien dire : il pleut mardi et
        le soleil revient jeudi. Chaque jour porte donc sa prévision, et la
        colonne du tableau qui suit s'en trouve corrigée.

        C'est une SAISIE : personne ne connaît le temps de jeudi depuis une base
        de données.
      #}
      <section class="card">
        <h2 class="card__title">{{ 'admin.parMatrix.weather'|trans }}</h2>
        <p class="field__hint">{{ 'admin.parMatrix.weatherIntro'|trans }}</p>

        <form method="post" action="{{ path('admin_weather_save') }}" class="form">
          {#
            Quatre silhouettes par jour, et non une liste déroulante.

            Une prévision se choisit d'un geste : sept listes demandaient sept
            ouvertures, sept défilements et sept fermetures pour dire ce qu'un
            regard sur des icônes dit tout de suite. Et le soleil, le nuage, la
            pluie et la neige se reconnaissent sans se lire — c'est le cas où
            le dessin bat le mot, y compris d'une langue à l'autre.

            Bâti sur des boutons radio, comme les vignettes de contenant : la
            sélection tient sans script et le clavier parcourt chaque jour
            comme un groupe.

            Le nom reste porté par un texte masqué : une silhouette ne dit rien
            à un lecteur d'écran, et le pourcentage suit dans l'infobulle.
          #}
          <div class="wpick">
            {% for day in days %}
              <fieldset class="wpick__day">
                <legend class="field__label">{{ ('days.' ~ day.value)|trans }}</legend>

                {#
                  Ce que le service annonce pour ce jour-là, quand une
                  prévision a été reçue.

                  Elle ne s'impose pas : le bouton radio en dessous reste ce
                  qui pilote le plan. Elle est là pour qu'on choisisse en
                  connaissance de cause — et pour qu'un écart saute aux yeux
                  avant qu'on ne lise les chiffres du tableau qui suit.
                #}
                {% set annonce = forecastByDay[day.value] ?? null %}
                {% if annonce %}
                  <p class="wpick__hint{{ annonce == dayWeathers[day.value] ? '' : ' wpick__hint--differs' }}">
                    {{ ui.icon(annonce.icon) }}
                    <span>{{ 'admin.parMatrix.forecast'|trans }}</span>
                  </p>
                {% endif %}

                <div class="wpick__row">
                  {% for temps in weatherKinds %}
                    {% set nom = ('admin.parMatrix.weathers.' ~ temps.value)|trans %}
                    <label class="wpick__item">
                      <input class="wpick__radio" type="radio"
                             name="day[{{ day.value }}]" value="{{ temps.value }}"
                             {{ temps == dayWeathers[day.value] ? 'checked' : '' }}>
                      <span class="wpick__box"
                            title="{{ nom }} — {{ weatherRatios[temps.value] > 0 ? '+' : '' }}{{ weatherRatios[temps.value] }} %">
                        {{ ui.icon(temps.icon) }}
                        <span class="visually-hidden">{{ nom }}</span>
                      </span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>

          {# La légende : ce que chaque temps retire ou ajoute, une fois pour
             toutes plutôt que dans chacune des vingt-huit options. #}
          <p class="field__hint wlegend">
            {% for temps in weatherKinds %}
              <span class="wlegend__item">
                {{ ui.icon(temps.icon) }}
                {{ ('admin.parMatrix.weathers.' ~ temps.value)|trans }}
                <strong>{{ weatherRatios[temps.value] > 0 ? '+' : '' }}{{ weatherRatios[temps.value] }} %</strong>
              </span>
            {% endfor %}
          </p>

          {# Les pourcentages eux-mêmes : repliés, parce qu'on les règle une
             fois par saison, alors que la prévision change chaque jour. #}
          <details class="mt">
            <summary class="admin-new__summary">
              {{ ui.icon('sliders') }}
              <span>{{ 'admin.parMatrix.weatherEdit'|trans }}</span>
            </summary>

            <div class="field-grid field-grid--tight">
              {% for temps in weatherKinds %}
                <div class="field">
                  <label class="field__label" for="w-{{ temps.value }}">
                    {{ ('admin.parMatrix.weathers.' ~ temps.value)|trans }}
                  </label>
                  <input class="field__input" type="number" step="0.1" min="-100" max="500"
                         id="w-{{ temps.value }}" name="weather[{{ temps.value }}]"
                         value="{{ weatherRatios[temps.value] }}">
                </div>
              {% endfor %}
            </div>

            <p class="field__hint">{{ 'admin.parMatrix.weatherEditHint'|trans }}</p>
          </details>

          <div class="form-actions">
            <button type="submit" class="button button--primary">{{ 'common.save'|trans }}</button>
          </div>
        </form>

        {# Le lien vers l'onglet Météo, et non un bouton « Appliquer » ici :
           appliquer relève de l'écran qui montre la semaine entière, avec ses
           températures et sa date de réception. Ici, on ne fait que signaler
           qu'une prévision existe. #}
        <p class="field__hint">
          <a href="{{ path('admin_weather') }}">{{ 'admin.parMatrix.weatherLink'|trans }}</a>
        </p>
      </section>

      {% if composedProducts is empty %}
        {{ ui.banner('info', 'admin.parMatrix.noComposed'|trans) }}
      {% else %}
        <section class="card">
          <div class="table-scroll">
            <table class="table table--matrix mins">
              <thead>
                <tr>
                  <th>{{ 'common.product'|trans }}</th>
                  {% for day in days %}
                    <th>
                      {{ ('daysShort.' ~ day.value)|trans }}
                      {# La prévision se rappelle au-dessus de sa colonne :
                         sans elle, on lirait un chiffre sans savoir sous quel
                         temps il a été calculé. #}
                      <span class="mins__weather" title="{{ ('admin.parMatrix.weathers.' ~ dayWeathers[day.value].value)|trans }}">
                        {{ ui.icon(dayWeathers[day.value].icon) }}
                      </span>
                    </th>
                  {% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for product in composedProducts %}
                  <tr>
                    <th scope="row">
                      {{ product_label(product) }}
                      {% if not product.active %}{{ ui.badge('warn', 'admin.products.inactive'|trans) }}{% endif %}
                    </th>
                    {% for day in days %}
                      {% set m = computed[day.value][product.id] ?? null %}
                      <td class="mins__cell">
                        {#
                          Muet en dessous de trois relevés : une moyenne bâtie
                          sur deux jours se laisse fausser par un seul jour de
                          soldes, et la donner pour un minimum tromperait. Le
                          tiret dit « pas encore », pas « zéro ».
                        #}
                        {% if m and m.isReliable %}
                          <span class="mins__value"
                                title="{{ 'admin.parMatrix.suggestionTitle'|trans({
                                  '%avg%': m.average|qty,
                                  '%samples%': m.samples,
                                  '%pct%': m.weatherPercent
                                }) }}">{{ m.value|qty }}</span>
                        {% else %}
                          <span class="mins__none" title="{{ 'admin.parMatrix.notEnough'|trans({
                            '%samples%': m ? m.samples : 0,
                            '%min%': 3
                          }) }}">—</span>
                        {% endif %}
                      </td>
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <p class="field__hint">{{ 'admin.parMatrix.computedFooter'|trans }}</p>
        </section>
      {% endif %}
    </section>
  </div>

{% endblock %}
