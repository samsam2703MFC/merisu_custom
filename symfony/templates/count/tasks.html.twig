{#
  Menu des tâches — écran d'accueil du poste.

  Remplace l'ancienne barre d'onglets en pied d'écran : le vendeur voit d'un
  coup d'œil ce qui lui reste à faire, plutôt que trois onglets sans état.
  L'administration n'y figure pas, elle a sa propre porte d'entrée.
#}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'tasks.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block content %}

  <div class="identity-bar">
    <span class="muted">{{ current_user().consultant.displayName }}</span>
  </div>

  <div class="page-header page-header--with-icon">
    <span class="page-header__icon">{{ ui.icon('clipboard') }}</span>
    <div class="page-header__text">
      <h1 class="page-header__title">{{ 'tasks.title'|trans }}</h1>
      <p class="page-header__subtitle">{{ date|long_date }}</p>
    </div>
  </div>

  <div class="task-list">
    {% for task in tasks %}
      <a class="task {{ task.highlight ? 'task--now' : '' }} {{ task.done ? 'task--done' : '' }}"
         href="{{ path(task.route) }}">

        <span class="task__icon">{{ ui.icon(task.icon) }}</span>

        <span class="task__body">
          <span class="task__label">{{ task.title|trans }}</span>
          <span class="task__meta">
            {# La check-list n'a pas d'heure : le séparateur disparaît avec. #}
            {% if task.time %}<span class="task__time">{{ task.time }}</span> · {% endif %}
            {% if task.done %}
              {{ task.doneKey|trans }}
            {% elseif task.saved > 0 %}
              {{ task.progressKey|trans({ '%saved%': task.saved, '%total%': task.total }) }}
            {% else %}
              {{ task.todoKey|trans({ '%total%': task.total }) }}
            {% endif %}
          </span>

          {% if task.done %}
            <span class="task__state">{{ ui.badge('ok', 'tasks.doneShort'|trans) }}</span>
          {% elseif task.highlight %}
            <span class="task__state">{{ ui.badge('neutral', 'tasks.nowShort'|trans) }}</span>
          {% endif %}
        </span>
      </a>
    {% endfor %}

    {#
      Production de demain. Tuile violette, à part des comptages : ce n'est pas
      une saisie mais une consigne de travail, et la couleur le dit avant le
      texte. L'icône suit l'état — cagette vide ou chargée — pour que la tuile
      se lise d'un coup d'œil, de loin, en cuisine.
    #}
    <a class="task task--produce" href="{{ path('production', { forDate: produce.forDate }) }}">
      <span class="task__icon">{{ ui.icon(produce.icon) }}</span>

      <span class="task__body">
        <span class="task__label">{{ 'produce.tileTitle'|trans }}</span>
        <span class="task__meta">
          {% if produce.count > 0 %}
            {{ 'tasks.planReady'|trans({ '%count%': produce.count }) }}
          {% else %}
            {{ 'tasks.noPlanTomorrow'|trans }}
          {% endif %}
        </span>

        {% if produce.count > 0 %}
          <span class="task__state">{{ ui.badge('neutral', produce.count) }}</span>
        {% endif %}
      </span>
    </a>

    {# Consultations, présentées à part des tâches à faire. #}
    <a class="task task--secondary" href="{{ path('network') }}">
      <span class="task__icon">{{ ui.icon('network') }}</span>

      <span class="task__body">
        <span class="task__label">{{ 'network.title'|trans }}</span>
        <span class="task__meta">{{ 'network.tileHint'|trans }}</span>
      </span>
    </a>

    {# Le plan du JOUR reste consultable, mais discrètement : c'est un rappel
       de ce qui est en cours, pas une tâche à ouvrir. #}
    <a class="task task--secondary" href="{{ path('production', { forDate: date }) }}">
      <span class="task__icon">{{ ui.icon('tray') }}</span>

      <span class="task__body">
        <span class="task__label">{{ 'produce.todayTitle'|trans }}</span>
        <span class="task__meta">
          {% if planForToday is empty %}
            {{ 'tasks.noPlan'|trans }}
          {% else %}
            {{ 'tasks.planReady'|trans({ '%count%': planForToday|length }) }}
          {% endif %}
        </span>
      </span>
    </a>
  </div>

{% endblock %}
