{#
  Check-list du poste — vue d'entrée.

  Un volet par carte, avec son avancement. Les points ne sont pas dépliés
  ici : le vendeur choisit d'abord ce qu'il vient traiter, et n'a pas à
  parcourir vingt lignes pour trouver les deux qui le concernent.
#}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'checklist.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block content %}

  <div class="identity-bar">
    <span class="muted">{{ current_user().consultant.displayName }}</span>
  </div>

  <div class="page-header page-header--with-icon">
    <span class="page-header__icon">{{ ui.icon('checklist') }}</span>
    <div class="page-header__text">
      <h1 class="page-header__title">{{ 'checklist.title'|trans }}</h1>
      <p class="page-header__subtitle">{{ date|long_date }}</p>
    </div>
  </div>

  {#
    Relire une JOURNÉE PASSÉE.

    La check-list du jour est ce qu'on vient faire ; celle d'hier est ce qu'on
    vient vérifier — « qui a signé quoi, et à quelle heure ». Deux liens
    suffisent : le futur n'existe pas ici, une check-list de demain n'a rien à
    montrer et l'ouvrir laisserait croire qu'on peut la préparer d'avance.
  #}
  <nav class="ck-days" aria-label="{{ 'checklist.dayNav'|trans }}">
    <a class="ck-days__step" href="{{ path('checklist', { date: date|day_before }) }}">
      {{ ui.icon('arrow-left') }} {{ 'checklist.dayBefore'|trans }}
    </a>

    {% if date != today %}
      <a class="ck-days__today" href="{{ path('checklist') }}">{{ 'checklist.backToToday'|trans }}</a>
      <a class="ck-days__step" href="{{ path('checklist', { date: date|day_after }) }}">
        {{ 'checklist.dayAfter'|trans }} {{ ui.icon('arrow-right') }}
      </a>
    {% endif %}
  </nav>

  {% if date != today %}
    {#
      Un jour passé se LIT, il ne se signe pas : ces lignes sont des pièces
      d'audit, et antidater une signature leur ôterait toute valeur de preuve.
    #}
    {{ ui.banner('info', 'checklist.pastDay'|trans) }}
  {% endif %}

  {% set aucunPoint = sections|reduce((total, s) => total + s.total, 0) == 0 %}

  {% if aucunPoint %}
    {{ ui.banner('info', 'checklist.empty'|trans) }}
  {% else %}
    <div class="ck-grid">
      {% for bloc in sections %}
        <a class="card card--link ck-card" href="{{ path('checklist_section', date == today ? { section: bloc.checklist.id } : { section: bloc.checklist.id, date: date }) }}">
          <div class="ck-card__head">
            <h2 class="card__title">{{ checklist_title(bloc.checklist) }}</h2>
            {% if bloc.time %}<span class="ck-card__time muted">{{ bloc.time }}</span>{% endif %}
          </div>

          <div class="ck-card__meta">
            <span class="muted">{{ 'checklist.progress'|trans({ '%done%': bloc.done, '%total%': bloc.total }) }}</span>

            {#
              Le pourcentage porte une couleur, mais jamais seule : le chiffre
              lui-même dit la même chose, et la barre en dessous aussi.
            #}
            <span class="ck-card__pct ck-card__pct--{{ bloc.percent == 100 ? 'full' : (bloc.percent > 0 ? 'part' : 'none') }}">
              {{ bloc.percent }} %
            </span>
          </div>

          <span class="ck-bar">
            <span class="ck-bar__fill ck-bar__fill--{{ bloc.percent == 100 ? 'full' : (bloc.percent > 0 ? 'part' : 'none') }}"
                  style="--w: {{ bloc.percent }}%"></span>
          </span>

          {# Un échec ne se noie pas dans un pourcentage : il se dit. #}
          {% if bloc.failed > 0 %}
            <span class="badge badge--danger">
              {{ 'checklist.failedCount'|trans({ '%count%': bloc.failed }) }}
            </span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% endif %}

{% endblock %}
