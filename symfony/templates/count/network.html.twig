{#
  Réseau — classement des boutiques.

  Deux tableaux, jamais mélangés : le pays d'abord, parce que c'est là que le
  vendeur se compare à des boutiques qui lui ressemblent, puis le monde.

  Écran de consultation : aucune saisie, aucun bouton d'enregistrement.
#}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'network.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block content %}

  <div class="page-header page-header--with-icon">
    <span class="page-header__icon">{{ ui.icon('network') }}</span>
    <div class="page-header__text">
      <h1 class="page-header__title">{{ 'network.title'|trans }}</h1>
      <p class="page-header__subtitle">
        {{ 'network.period'|trans({ '%from%': from|long_date, '%to%': to|long_date }) }}
      </p>
    </div>
  </div>

  {#
    Les chiffres viennent de la caisse. Tant qu'elle n'est pas branchée, le
    dire franchement vaut mieux que laisser croire à de vraies mesures.
  #}
  {% if is_demo_ranking() %}
    {{ ui.banner('warn', 'network.demoWarning'|trans) }}
  {% endif %}

  {# Deux critères, deux moitiés : un interrupteur, pas une liste de choix.
     Ils ne désignent pas les mêmes gagnants — une boutique de gare fait
     beaucoup de clients et peu de tiramisu chacun. #}
  <div class="metric-switch metric-switch--pair" role="tablist">
    {% for choix in metrics %}
      <a class="metric-switch__item {{ choix == metric ? 'is-active' : '' }}"
         role="tab" aria-selected="{{ choix == metric ? 'true' : 'false' }}"
         href="{{ path('network', { metric: choix.value }) }}">
        {{ choix.labelKey|trans }}
      </a>
    {% endfor %}
  </div>

  {#
    Jauge tiramisu du mois.

    Elle ne s'affiche que si un objectif est fixé en administration : une barre
    sans repère ne dit rien, et une barre pleine par défaut serait un mensonge.

    Le repère de rythme (le trait vertical) est ce qui rend la jauge utile :
    « 600 sur 1 000 » est excellent le 10 du mois et inquiétant le 28.
  #}
  {% if gauge %}
    <section class="card gauge {{ gauge.reached ? 'gauge--reached' : (gauge.onTrack ? 'gauge--ontrack' : 'gauge--late') }}">
      <header class="gauge__header">
        <h2 class="card__title">{{ 'network.gauge.title'|trans }}</h2>
        <span class="gauge__percent">{{ gauge.percent }} %</span>
      </header>

      <p class="gauge__figures">
        <span class="gauge__sold">{{ gauge.sold }}</span>
        <span class="muted">/ {{ gauge.target }} {{ 'network.gauge.unit'|trans }}</span>
      </p>

      {# `role=img` plutôt qu'une barre de progression : le texte au-dessus dit
         déjà les chiffres, et un lecteur d'écran n'a pas à les entendre deux
         fois. La barre est ici un dessin, rien de plus. #}
      <div class="gauge__track" role="img"
           aria-label="{{ 'network.gauge.progress'|trans({ '%sold%': gauge.sold, '%target%': gauge.target }) }}">
        <div class="gauge__fill" style="--fill: {{ gauge.barPercent }}%"></div>
        <div class="gauge__pace" style="--pace: {{ gauge.monthElapsed }}%"></div>
      </div>

      <p class="muted gauge__hint">
        {% if gauge.reached %}
          {{ 'network.gauge.reached'|trans }}
        {% else %}
          {{ 'network.gauge.remaining'|trans({ '%count%': gauge.remaining }) }}
          · {{ 'network.gauge.pace'|trans({ '%percent%': gauge.monthElapsed }) }}
        {% endif %}
      </p>
    </section>
  {% endif %}

  {% if myNational or myWorldwide %}
    <section class="card standing">
      <h2 class="card__title">{{ 'network.myPosition'|trans }}</h2>
      <div class="standing__figures">
        {% if myNational %}
          <div class="standing__figure">
            <span class="standing__rank">{{ myNational.rank }}<sup>{{ 'network.rankSuffix'|trans }}</sup></span>
            <span class="standing__scope">
              {{ 'network.inCountry'|trans({ '%country%': ('countries.' ~ country)|trans }) }}
              <span class="muted">/ {{ myNational.total }}</span>
            </span>
          </div>
        {% endif %}

        {% if myWorldwide %}
          <div class="standing__figure">
            <span class="standing__rank">{{ myWorldwide.rank }}<sup>{{ 'network.rankSuffix'|trans }}</sup></span>
            <span class="standing__scope">
              {{ 'network.worldwide'|trans }}
              <span class="muted">/ {{ myWorldwide.total }}</span>
            </span>
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {# ── Classement national ──────────────────────────────────────────────── #}
  <section class="card">
    <header class="card__header">
      <h2 class="card__title">
        {{ country ? ('countries.' ~ country)|trans : 'network.nationalRanking'|trans }}
      </h2>

      {# Le pays de la boutique du poste, et lui seul : on vient voir où l'on
         se situe chez soi. Naviguer vers le classement polonais depuis Paris
         n'apprenait rien qu'on ne lise déjà dans le classement mondial. #}
      {% if country %}{{ ui.flag(country, ('countries.' ~ country)|trans) }}{% endif %}
    </header>

    {{ _self.classement(national, metric, 'network.empty'|trans, false) }}
  </section>

  {# ── Classement mondial ───────────────────────────────────────────────── #}
  <section class="card">
    <h2 class="card__title">{{ 'network.worldwide'|trans }}</h2>

    {# Vraiment mondial, depuis que le chiffre d'affaires n'est plus proposé :
       des clients et des tiramisu se comptent à l'identique partout, et aucune
       boutique n'est plus écartée faute de partager la devise. #}
    {{ _self.classement(worldwide, metric, 'network.empty'|trans, true) }}
  </section>

{% endblock %}

{#
  Un classement. Les trois premiers portent une médaille : c'est ce qu'on
  cherche des yeux avant de lire les chiffres.
#}
{% macro classement(lignes, metric, vide, avecDrapeaux) %}
  {% if lignes is empty %}
    <p class="muted">{{ vide }}</p>
  {% else %}
    <ol class="rank {{ avecDrapeaux ? 'rank--flagged' : '' }}">
      {% for ligne in lignes %}
        <li class="rank__row{{ ligne.isCurrent ? ' rank__row--mine' : '' }}">
          <span class="rank__badge rank__badge--{{ ligne.rank <= 3 ? ligne.rank : 'other' }}">{{ ligne.rank }}</span>

          {# Plus d'étiquette « votre boutique » : la ligne est déjà mise en
             surbrillance, et un libellé de plus la faisait passer à la ligne
             sur téléphone. Le repère reste lisible sans lecture. #}
          <span class="rank__shop">
            {{ ligne.shop.name }}
            {% if ligne.isCurrent %}
              <span class="visually-hidden">— {{ 'network.yourShop'|trans }}</span>
            {% endif %}
          </span>

          {# Le drapeau a sa propre colonne, juste avant le chiffre : en suivant
             le nom, il se décalait à chaque ligne au gré de la longueur des
             noms, et l'œil devait le chercher. Aligné, il se lit en une seule
             descente du regard.

             Classement MONDIAL seulement : dans le national, toutes les
             boutiques sont du même pays et la colonne ne dirait rien. #}
          {% if avecDrapeaux %}
            <span class="rank__flag">
              {% if ligne.shop.country %}
                {{ ui.flag(ligne.shop.country, ('countries.' ~ ligne.shop.country|upper)|trans) }}
              {% endif %}
            </span>
          {% endif %}

          <span class="rank__value">{{ ligne.value|qty }}</span>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
{% endmacro %}
