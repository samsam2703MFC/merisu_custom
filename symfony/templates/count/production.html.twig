{# §7.4 — Écran « À produire » : le plan figé à la validation du soir. #}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% block title %}{{ 'produce.title'|trans }} — {{ 'common.appName'|trans }}{% endblock %}

{% block content %}

  <div class="identity-bar">
    <span class="muted">{{ current_user().consultant.displayName }}</span>
  </div>

  {{ ui.page_header(
    'produce.title'|trans,
    'produce.subtitle'|trans({ '%date%': forDate|long_date }) ~ ' · ' ~ ('days.' ~ dayOfWeek.value)|trans
  ) }}


    <section class="card">
      <form class="filters" method="get" action="{{ path('production') }}">
        <div class="field">
          <label class="field__label" for="forDate">{{ 'common.date'|trans }}</label>
          <input class="field__input" type="date" id="forDate" name="forDate" value="{{ forDate }}">
        </div>

        {# Le filtre par catégorie ne s'affiche que si des catégories existent :
           un menu à une seule entrée n'aide personne. #}
        {% if categories|length > 0 %}
          <div class="field">
            <label class="field__label" for="category">{{ 'produce.category'|trans }}</label>
            {# Choisir une catégorie applique le filtre : un clic de moins, et
               le bouton « Appliquer » reste là pour qui n'a pas de script. #}
            <select class="field__input" id="category" name="category" data-autosubmit>
              <option value="">{{ 'produce.allCategories'|trans }}</option>
              {% for name in categories %}
                <option value="{{ name }}" {{ name == category ? 'selected' : '' }}>{{ name }}</option>
              {% endfor %}
            </select>
          </div>
        {% endif %}

        <div class="filters__actions">
          <button type="submit" class="button button--secondary">{{ 'common.apply'|trans }}</button>

          {# Raccourcis : le consultant regarde presque toujours aujourd'hui ou
             demain. Ils vont par paire et restent côte à côte, même étroits. #}
          <a class="button button--secondary" href="{{ path('production', { forDate: today, category: category }) }}">
            {{ 'produce.shortcutToday'|trans }}
          </a>
          <a class="button button--secondary" href="{{ path('production', { forDate: tomorrow, category: category }) }}">
            {{ 'produce.shortcutTomorrow'|trans }}
          </a>
        </div>
      </form>
    </section>

    {% if lines is empty %}
      {% if category %}
        <div class="banner banner--warn">
          {{ 'produce.emptyCategory'|trans({ '%category%': category }) }}
        </div>
      {% else %}
        {#
          Pas de plan, et la raison est presque toujours la même : le stock du
          soir de la veille n'a pas été validé, donc rien n'a pu être calculé.
          Le dire, et ouvrir la porte — « aucun plan figé » laissait chercher.
        #}
        <section class="card">
          <div class="banner banner--warn">{{ 'produce.needEveningCount'|trans }}</div>
          <p class="muted">{{ 'produce.needEveningCountHint'|trans({ '%date%': computedFromDate|long_date }) }}</p>

          <div class="form-actions">
            <a class="button button--primary" href="{{ path('count_evening') }}">
              {{ 'evening.title'|trans }}
            </a>
          </div>
        </section>
      {% endif %}
    {% else %}
      <p class="muted">
        {{ 'produce.computedFrom'|trans({ '%date%': computedFromDate|long_date }) }}
        · {{ 'produce.frozenAt'|trans({ '%datetime%': lines|first.computedAt|datetime_short }) }}
      </p>

      {#
        D'où sortent ces quantités.

        Une quantité qui change toute seule d'un jour à l'autre inquiète tant
        qu'on ne sait pas qu'elle SUIT la demande. La phrase vaut pour tout
        plan figé depuis que le calcul pilote la production ; elle ne prétend
        pas dire, ligne par ligne, laquelle vient de l'historique — le plan
        figé ne conserve pas cette distinction.
      #}
      <p class="field__hint">{{ 'produce.source'|trans }}</p>

      {% if lines|filter(l => l.missingThreshold)|length > 0 %}
        <div class="banner banner--warn">{{ 'produce.missingThreshold'|trans }}</div>
      {% endif %}

      {#
        L'avancement de l'atelier.

        Seules les lignes À PRODUIRE comptent : un plan de vingt lignes dont
        quinze sont à zéro n'est pas « 5/20 fait ». Les mêmes tuiles et la même
        barre que la check-list — un chiffre qui compte se présente partout de
        la même façon.
      #}
      {% if progress.total > 0 %}
        <section class="card">
          <div class="stats stats--compact">
            <div class="stat">
              <p class="stat__label">{{ 'produce.statTotal'|trans }}</p>
              <p class="stat__value">{{ progress.total }}</p>
            </div>
            <div class="stat">
              <p class="stat__label">{{ 'produce.statDone'|trans }}</p>
              <p class="stat__value stat__value--ok">{{ progress.done }}</p>
            </div>
            <div class="stat">
              <p class="stat__label">{{ 'produce.statLeft'|trans }}</p>
              <p class="stat__value stat__value--todo">{{ progress.left }}</p>
            </div>
          </div>

          <span class="ck-bar ck-bar--lg">
            <span class="ck-bar__fill ck-bar__fill--{{ progress.percent == 100 ? 'full' : (progress.percent > 0 ? 'part' : 'none') }}"
                  style="--w: {{ progress.percent }}%"></span>
          </span>
        </section>
      {% endif %}

      {# Impression des étiquettes depuis la liste elle-même : le lien porte la
         date et la catégorie affichées, on imprime donc ce qu'on regarde. #}
      <div class="form-actions">
        <a class="button button--primary"
           href="{{ path('production_labels', { forDate: forDate, category: category }) }}">
          <span class="button__icon">{{ ui.icon('printer') }}</span>
          {{ 'produce.printLabels'|trans }}
        </a>
      </div>

      <div class="count-list">
        {% for line in lines %}
          {% set product = products[line.productId] ?? null %}
          {% set entry = entries[line.productId] ?? null %}
          {# La MÊME question que la barre d'avancement, posée par le domaine :
             deux définitions du « à faire » auraient fini par diverger, et la
             barre n'aurait plus décrit les cases affichées. #}
          {% set aFaire = line.qtyToProduce > 0 or line.missingThreshold %}

          <article class="count-item produce-item {{ entry ? 'produce-item--done' : '' }}">
            <header class="count-item__header">
              {#
                La case à cocher est un LIEN, pas une case.

                Cocher engage un nom : il faut donc un code, et un code ne se
                saisit pas dans une case à cocher. Le lien mène à l'écran de
                signature — le même geste qu'un point de check-list, pour la
                même raison. Une vraie case aurait été plus rapide et aurait
                menti sur qui a produit.
              #}
              {% if aFaire %}
                <a class="produce-check {{ entry ? 'produce-check--done' : '' }}"
                   href="{{ path('production_done', { productId: line.productId, forDate: forDate, category: category }) }}"
                   aria-label="{{ (entry ? 'produce.undoLine' : 'produce.markLine')|trans({
                     '%product%': product ? product_label(product) : line.productId
                   }) }}">
                  {% if entry %}{{ ui.icon('check') }}{% endif %}
                </a>
              {% endif %}

              <span class="count-item__name">
                {{ product ? product_label(product) : line.productId }}
              </span>
              {% if product and product.category %}
                {{ ui.badge('neutral', product.category) }}
              {% endif %}
              {% if line.missingThreshold %}
                {{ ui.badge('warn', 'common.notDefined'|trans) }}
              {% endif %}

              {#
                Imprimer CETTE ligne. Sans elle, terminer une fournée obligeait
                à retirer toute la planche du jour pour une seule étiquette.
                Absente quand il n'y a rien à produire : une étiquette « 0 »
                gaspille du papier et embrouille le plan de travail.
              #}
              {% if line.qtyToProduce > 0 %}
                <a class="produce-item__print"
                   href="{{ path('production_labels', { forDate: forDate, productId: line.productId }) }}"
                   title="{{ 'produce.printLine'|trans }}"
                   aria-label="{{ 'produce.printLineOf'|trans({
                     '%product%': product ? product_label(product) : line.productId
                   }) }}">
                  {{ ui.icon('printer') }}
                </a>
              {% endif %}
            </header>

            <p class="produce-item__qty">
              <span class="produce-item__value">{{ line.qtyToProduce|qty }}</span>
              <span class="produce-item__unit muted">{{ product ? product.unit : '' }}</span>
            </p>

            <p class="muted">
              {{ 'produce.required'|trans }} : {{ line.requiredPieces|qty }}
              · {{ 'produce.closingStock'|trans }} : {{ line.closingStock|qty }}
            </p>

            {#
              Qui l'a faite, et quand. C'est la raison d'être du code : la
              ligne porte le nom de qui a réellement produit, et non de qui
              avait ouvert la session ce matin-là.
            #}
            {% if entry %}
              <p class="produce-item__who">
                {{ ui.icon('check') }}
                {{ 'produce.doneBy'|trans({
                  '%name%': doneBy[line.productId] ?? '—',
                  '%time%': entry.doneAt|time_short
                }) }}
              </p>
            {% endif %}

            {% if line.qtyToProduce == 0 and not line.missingThreshold %}
              {{ ui.badge('ok', 'produce.nothing'|trans) }}
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

{% endblock %}
