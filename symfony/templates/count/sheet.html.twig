{#
  §7.2 / §7.3 — Écrans de saisie du matin (08:00) et du soir (22:00).

  Un seul gabarit sert les deux moments : seule la validation verrouillante,
  qui fige le plan du lendemain, est propre au comptage du soir.
#}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% set isEvening = moment.isEvening %}
{% set settings = app_settings() %}
{% set momentSlug = isEvening ? 'soir' : 'matin' %}
{% set issuesByProduct = {} %}
{% for issue in issues|filter(i => i.productId) %}
  {% set issuesByProduct = issuesByProduct|merge({ (issue.productId): issue.code }) %}
{% endfor %}

{% block title %}
  {{ (isEvening ? 'evening.title' : 'morning.title')|trans }} — {{ 'common.appName'|trans }}
{% endblock %}

{% block content %}

  {# Poste en lecture seule : il est tracé sur chaque saisie, et se change
     depuis le menu de l'avatar. #}
  <div class="identity-bar">
    <span class="muted">{{ current_user().consultant.displayName }}</span>
    <span class="identity-bar__workstation">{{ workstation_name(workstationId) }}</span>
  </div>

  {{ ui.page_header(
    (isEvening ? 'evening.title' : 'morning.title')|trans,
    (isEvening ? 'evening.subtitle' : 'morning.subtitle')|trans({
      '%time%': isEvening ? settings.closingTime : settings.openingTime,
      '%date%': date|long_date
    })
  ) }}

  {# Problèmes globaux remontés par la validation (photo manquante…). #}
  {% for issue in issues|filter(i => not i.productId) %}
    <p class="banner banner--danger" role="alert">{{ ('validation.' ~ issue.code)|trans }}</p>
  {% endfor %}

  {% if validated %}
    <div class="banner banner--ok" role="status">
      {{ (isEvening ? 'evening.validated' : 'morning.validated')|trans({ '%time%': validatedAt|time_short }) }}
      <br><span class="muted">{{ 'evening.lockedHint'|trans }}</span>
    </div>
  {% endif %}

  {#
    §3.2.4 — production à réaliser demain, affichée juste après la validation
    du soir, sans que le consultant ait à changer d'écran.
  #}
  {% if isEvening and freshPlan is not empty %}
    <section class="card">
      <h2 class="card__title">{{ 'produce.title'|trans }}</h2>
      <p class="muted">{{ 'produce.subtitle'|trans({ '%date%': freshPlan|first.forDate|long_date }) }}</p>

      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>{{ 'common.product'|trans }}</th>
              <th>{{ 'produce.required'|trans }}</th>
              <th>{{ 'produce.closingStock'|trans }}</th>
              <th>{{ 'produce.qtyToProduce'|trans }}</th>
            </tr>
          </thead>
          <tbody>
            {% for line in freshPlan %}
              {% set product = products|filter(p => p.id == line.productId)|first %}
              <tr>
                <td>
                  {{ product ? product_label(product) : line.productId }}
                  {% if line.missingThreshold %}{{ ui.badge('warn', 'common.notDefined'|trans) }}{% endif %}
                </td>
                <td>{{ line.requiredPieces|qty }}</td>
                <td>{{ line.closingStock|qty }}</td>
                <td><strong>{{ line.qtyToProduce|qty }}</strong> {{ product ? product.unit : '' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  {# Le matin : rappel du plan calculé la veille au soir (§3.1.3). #}
  {% if not isEvening %}
    <section class="card">
      <h2 class="card__title">{{ 'morning.planTitle'|trans }}</h2>

      {% if planForToday is empty %}
        <p class="muted">{{ 'morning.planEmpty'|trans }}</p>
      {% else %}
        <p class="muted">{{ 'morning.planHint'|trans }}</p>
        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr>
                <th>{{ 'common.product'|trans }}</th>
                <th>{{ 'produce.qtyToProduce'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for line in planForToday %}
                {% set product = products|filter(p => p.id == line.productId)|first %}
                <tr>
                  <td>{{ product ? product_label(product) : line.productId }}</td>
                  <td><strong>{{ line.qtyToProduce|qty }}</strong> {{ product ? product.unit : '' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>
  {% endif %}

  {#
    Formulaire de comptage.
    `data-count-form` est le point d'accroche de la file hors-ligne (app.js).
  #}
  <form method="post"
        action="{{ path('count_save', { moment: momentSlug }) }}"
        class="form"
        data-count-form
        data-date="{{ date }}"
        data-moment="{{ moment.value }}"
        data-workstation="{{ workstationId }}"
        data-sync-url="{{ path('sync_replay') }}">

    <input type="hidden" name="date" value="{{ date }}">
    <input type="hidden" name="workstationId" value="{{ workstationId }}">

    <div class="count-list">
      {% for product in products %}
        {% set count = counts[product.id] ?? null %}
        {% set net = nets[product.id] ?? null %}
        {% set issueCode = issuesByProduct[product.id] ?? null %}

        <article class="count-item {{ issueCode ? 'count-item--invalid' : '' }}">
          <header class="count-item__header">
            <span class="count-item__name">{{ product_label(product) }}</span>
            <span class="count-item__unit muted">{{ product.unit }}</span>
          </header>

          {#
            Deux façons de saisir selon le produit : à l'unité, ou en
            contenants pleins plus une fraction pour celui qui est entamé.
          #}
          {% if product.countMode.isContainer %}
            {% set part = container_split(count ? count.qty : null) %}
            {{ ui.container_field(
              product,
              count ? part.whole : '',
              part.percent,
              validated,
              product_label(product)
            ) }}
          {% else %}
            {{ ui.qty_field(product, count ? count.qty|qty('') : '', validated, product_label(product)) }}
          {% endif %}

          {% if isEvening and net and net.netConsumption is not null %}
            <p class="count-item__net muted">
              {{ 'evening.netConsumption'|trans }} : {{ net.netConsumption|qty }} {{ product.unit }}
            </p>
          {% endif %}

          {% if issueCode %}
            <p class="badge badge--danger">{{ ('validation.' ~ issueCode)|trans }}</p>
          {% endif %}

        </article>
      {% endfor %}
    </div>

    <div class="form-actions">
      <button type="submit" class="button button--secondary" {{ validated ? 'disabled' : '' }}>
        {{ 'common.save'|trans }}
      </button>

      <button type="submit"
              class="button button--primary button--large"
              formaction="{{ path('count_validate', { moment: momentSlug }) }}"
              data-confirm="{{ isEvening ? 'evening.confirmBody'|trans : '' }}"
              {{ validated ? 'disabled' : '' }}>
        {{ (isEvening ? 'evening.validate' : 'morning.validate')|trans }}
      </button>
    </div>
  </form>

{% endblock %}
