{#
  §7.2 / §7.3 — Écrans de saisie du matin (08:00) et du soir (22:00).

  Un seul gabarit sert les deux moments : seule la validation verrouillante,
  qui fige le plan du lendemain, est propre au comptage du soir.
#}
{% extends 'base.html.twig' %}
{% import 'components/_macros.html.twig' as ui %}

{% set isEvening = moment.isEvening %}
{% set settings = app_settings() %}
{% set momentSlug = isEvening ? 'soir' : 'matin' %}
{% set issuesByProduct = {} %}
{% for issue in issues|filter(i => i.productId) %}
  {% set issuesByProduct = issuesByProduct|merge({ (issue.productId): issue.code }) %}
{% endfor %}

{% block title %}
  {{ (isEvening ? 'evening.title' : 'morning.title')|trans }} — {{ 'common.appName'|trans }}
{% endblock %}

{% block content %}

  {# Poste en lecture seule : il est tracé sur chaque saisie, et se change
     depuis le menu de l'avatar. #}
  <div class="identity-bar">
    <span class="muted">{{ current_user().consultant.displayName }}</span>
  </div>

  {{ ui.page_header(
    (isEvening ? 'evening.title' : 'morning.title')|trans,
    (isEvening ? 'evening.subtitle' : 'morning.subtitle')|trans({
      '%time%': isEvening ? settings.closingTime : settings.openingTime,
      '%date%': date|long_date
    })
  ) }}

  {# Problèmes globaux remontés par la validation (photo manquante…). #}
  {% for issue in issues|filter(i => not i.productId) %}
    <p class="banner banner--danger" role="alert">{{ ('validation.' ~ issue.code)|trans }}</p>
  {% endfor %}

  {% if validated %}
    <div class="banner banner--ok" role="status">
      {{ (isEvening ? 'evening.validated' : 'morning.validated')|trans({ '%time%': validatedAt|time_short }) }}
      <br><span class="muted">{{ 'evening.lockedHint'|trans }}</span>
    </div>
  {% endif %}

  {#
    §3.2.4 — production à réaliser demain, affichée juste après la validation
    du soir, sans que le consultant ait à changer d'écran.
  #}
  {% if isEvening and freshPlan is not empty %}
    <section class="card">
      <h2 class="card__title">{{ 'produce.title'|trans }}</h2>
      <p class="muted">{{ 'produce.subtitle'|trans({ '%date%': freshPlan|first.forDate|long_date }) }}</p>

      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>{{ 'common.product'|trans }}</th>
              <th>{{ 'produce.required'|trans }}</th>
              <th>{{ 'produce.closingStock'|trans }}</th>
              <th>{{ 'produce.qtyToProduce'|trans }}</th>
            </tr>
          </thead>
          <tbody>
            {% for line in freshPlan %}
              {% set product = products|filter(p => p.id == line.productId)|first %}
              <tr>
                <td>
                  {{ product ? product_label(product) : line.productId }}
                  {% if line.missingThreshold %}{{ ui.badge('warn', 'common.notDefined'|trans) }}{% endif %}
                </td>
                <td>{{ line.requiredPieces|qty }}</td>
                <td>{{ line.closingStock|qty }}</td>
                <td><strong>{{ line.qtyToProduce|qty }}</strong> {{ product ? product.unit : '' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  {# Le matin : rappel du plan calculé la veille au soir (§3.1.3). #}
  {% if not isEvening %}
    <section class="card">
      <h2 class="card__title">{{ 'morning.planTitle'|trans }}</h2>

      {% if planForToday is empty %}
        <p class="muted">{{ 'morning.planEmpty'|trans }}</p>
      {% else %}
        <p class="muted">{{ 'morning.planHint'|trans }}</p>
        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr>
                <th>{{ 'common.product'|trans }}</th>
                <th>{{ 'produce.qtyToProduce'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for line in planForToday %}
                {% set product = products|filter(p => p.id == line.productId)|first %}
                <tr>
                  <td>{{ product ? product_label(product) : line.productId }}</td>
                  <td><strong>{{ line.qtyToProduce|qty }}</strong> {{ product ? product.unit : '' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </section>
  {% endif %}

  {#
    Formulaire de comptage.
    `data-count-form` est le point d'accroche de la file hors-ligne (app.js).
  #}
  <form method="post"
        action="{{ path('count_save', { moment: momentSlug }) }}"
        class="form"
        data-count-form
        data-date="{{ date }}"
        data-moment="{{ moment.value }}"
        data-workstation="{{ workstationId }}"
        data-sync-url="{{ path('sync_replay') }}">

    <input type="hidden" name="date" value="{{ date }}">
    <input type="hidden" name="workstationId" value="{{ workstationId }}">

    {#
      Carrousel des catégories : une seule rangée qui se fait glisser au doigt.

      À plat, cinq puces débordaient sur trois lignes et poussaient la première
      saisie hors de l'écran. En rangée glissante, elles tiennent sur une ligne
      quel que soit leur nombre — dix catégories ne changeront rien.

      La puce touchée ouvre son groupe et vient se centrer. Sans script, ce
      sont de simples ancres : le groupe visé s'ouvre quand même, le
      navigateur défile jusqu'à lui, et rien n'est perdu.
    #}
    {% if productGroups|length > 1 %}
      <nav class="cat-swipe" aria-label="{{ 'produce.category'|trans }}">
        {% for groupe in productGroups %}
          {% set saisis = groupe.products|filter(p => counts[p.id] is defined)|length %}
          <a class="cat-swipe__chip {{ saisis == groupe.products|length ? 'is-done' : '' }}"
             href="#cat-{{ loop.index }}"
             data-cat-chip="cat-{{ loop.index }}">
            <span class="cat-swipe__name">{{ groupe.category ?: 'produce.uncategorised'|trans }}</span>
            <span class="cat-swipe__count">{{ saisis }}/{{ groupe.products|length }}</span>
          </a>
        {% endfor %}
      </nav>
    {% endif %}

    {#
      Une catégorie, un repli.

      Vingt-cinq produits à plat font six hauteurs d'écran. Repliés, les cinq
      groupes tiennent sur un seul : on voit d'un coup ce qui reste à compter,
      et on n'ouvre que le groupe qu'on a devant soi. Le compteur « 3/5 » du
      résumé suffit à suivre l'avancement sans rien déplier.

      Tous repliés à l'ouverture, y compris ceux déjà terminés : le vendeur
      choisit par quoi il commence, l'écran ne choisit pas pour lui.

      Les champs d'un groupe replié restent dans le formulaire et s'envoient
      normalement — un repli cache, il ne retire pas.
    #}
    {% for groupe in productGroups %}
      {% set saisis = groupe.products|filter(p => counts[p.id] is defined)|length %}
      {% set complet = saisis == groupe.products|length %}

      {# `name` partagé : le navigateur n'en laisse qu'un ouvert à la fois, et
         c'est lui qui referme le précédent — aucun script pour cela. #}
      <details class="cat {{ complet ? 'cat--done' : '' }}"
               name="categories" id="cat-{{ loop.index }}">
        <summary class="cat__summary">
          <span class="cat__name">{{ groupe.category ?: 'produce.uncategorised'|trans }}</span>

          {#
            Rayon de matières premières : ce qu'on commande, pas ce qu'on
            fabrique. Le repère change ce que le vendeur fait du chiffre — un
            stock bas de mascarpone se rattrape par une commande, pas par une
            fournée — et ces lignes n'apparaîtront pas à l'écran « À produire ».

            Affiché seulement quand TOUT le groupe est de la matière : sur un
            rayon panaché, le dire serait faux pour la moitié des lignes.
          #}
          {% if groupe.products|filter(p => p.nature.isRaw)|length == groupe.products|length %}
            {% set nature = 'admin.products.natures.RAW'|trans %}
            <span class="badge badge--info badge--icon" title="{{ nature }}">
              {{ ui.icon('nature-raw', nature) }}
            </span>
          {% endif %}

          <span class="cat__count">{{ saisis }}/{{ groupe.products|length }}</span>
          <span class="task__chevron" aria-hidden="true"></span>
        </summary>

    <div class="count-list">
      {% for product in groupe.products %}
        {% set count = counts[product.id] ?? null %}
        {% set net = nets[product.id] ?? null %}
        {% set issueCode = issuesByProduct[product.id] ?? null %}

        <article class="count-item {{ issueCode ? 'count-item--invalid' : '' }}">
          <header class="count-item__header">
            {#
              La silhouette du contenant, à côté de l'unité.

              Elle annonce au vendeur ce qu'il doit avoir en main avant même
              qu'il lise l'unité : devant une bouteille, on ne compte pas comme
              devant une cagette. Elle explique aussi pourquoi ce produit-là
              propose un pourcentage et le voisin non.

              Muette pour les lecteurs d'écran : l'unité juste à côté dit déjà
              la même chose en toutes lettres.
            #}
            {% if product.countMode.isContainer %}
              <span class="count-item__vessel">{{ ui.icon(product.containerType.icon) }}</span>
            {% endif %}
            <span class="count-item__name">{{ product_label(product) }}</span>
            <span class="count-item__unit muted">{{ product.unit }}</span>
          </header>

          {#
            Deux façons de saisir selon le produit : à l'unité, ou en
            contenants pleins plus une fraction pour celui qui est entamé.
          #}
          {% if product.countMode.isContainer %}
            {% set part = container_split(count ? count.qty : null) %}
            {{ ui.container_field(
              product,
              count ? part.whole : '',
              part.percent,
              validated,
              product_label(product)
            ) }}
          {% else %}
            {{ ui.qty_field(product, count ? count.qty|qty('') : '', validated, product_label(product)) }}
          {% endif %}

          {% if isEvening and net and net.netConsumption is not null %}
            <p class="count-item__net muted">
              {{ 'evening.netConsumption'|trans }} : {{ net.netConsumption|qty }} {{ product.unit }}
            </p>
          {% endif %}

          {% if issueCode %}
            <p class="badge badge--danger">{{ ('validation.' ~ issueCode)|trans }}</p>
          {% endif %}

        </article>
      {% endfor %}
    </div>
      </details>
    {% endfor %}

    {#
      Barre d'action collée au bas de l'écran sur téléphone.

      Huit produits, c'est déjà trois hauteurs d'écran : avec les boutons en
      fin de page, le vendeur comptait, puis devait redescendre pour
      enregistrer — et un comptage non enregistré est un comptage perdu.
      La barre suit maintenant le défilement, l'action reste sous le pouce.
    #}
    <div class="form-actions form-actions--sticky">
      <button type="submit" class="button button--secondary" {{ validated ? 'disabled' : '' }}>
        {{ 'common.save'|trans }}
      </button>

      <button type="submit"
              class="button button--primary button--large"
              formaction="{{ path('count_validate', { moment: momentSlug }) }}"
              data-confirm="{{ isEvening ? 'evening.confirmBody'|trans : '' }}"
              {{ validated ? 'disabled' : '' }}>
        {{ (isEvening ? 'evening.validate' : 'morning.validate')|trans }}
      </button>
    </div>
  </form>

{% endblock %}
