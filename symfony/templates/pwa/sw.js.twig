/*
 * Service worker — MERISU Inventaire & Production.
 *
 * Écrit à la main, sans Workbox : les besoins sont simples et une dépendance de
 * build serait disproportionnée pour un module Symfony.
 *
 * Stratégies :
 *   · ressources statiques (CSS, JS, icônes) → cache d'abord, mises en cache à
 *     l'installation pour que l'application démarre hors-ligne ;
 *   · pages HTML → réseau d'abord, cache en secours (le poste peut perdre le
 *     réseau en pleine saisie) ;
 *   · écritures (POST) → jamais interceptées : elles passent par la file
 *     d'attente IndexedDB gérée par app.js, qui garantit l'ordre du rejeu.
 */
/*
 * La version est l'empreinte du dossier `assets/`, calculée côté serveur.
 *
 * Elle NE DOIT PAS être écrite à la main : une constante figée fait que le nom
 * du cache ne change jamais, donc que la purge à l'activation ne supprime
 * jamais rien, donc qu'une feuille de style mise en cache le premier jour est
 * resservie indéfiniment. Le poste de travail affichait alors une interface
 * périmée qu'aucun rechargement ne corrigeait.
 */
const VERSION = 'merisu-{{ version }}';

/*
 * Racine réelle de l'application, déduite de la portée du service worker.
 * Elle vaut « / » à la racine du domaine, « /merisu/ » en sous-répertoire :
 * les chemins ci-dessous doivent la suivre, sinon rien n'est trouvé.
 */
const BASE = new URL(self.registration.scope).pathname;
/* Les deux ressources versionnées portent la même empreinte que dans le HTML :
   sans cela le service worker mettrait en cache des URL que la page ne demande
   jamais, et le mode hors-ligne servirait du vide. */
const V = '?v={{ version }}';
const STATIC_ASSETS = [
  BASE + 'assets/styles.css' + V,
  BASE + 'assets/fonts/fonts.css',
  BASE + 'assets/fonts/JTUSjIg1_i6t8kCHKm459Wdhyzbi.woff2',
  BASE + 'assets/fonts/JTUSjIg1_i6t8kCHKm459Wlhyw.woff2',
  BASE + 'assets/fonts/nuFiD-vYSZviVYUb_rj3ij__anPXDTLYgFE_.woff2',
  BASE + 'assets/fonts/nuFiD-vYSZviVYUb_rj3ij__anPXDTzYgA.woff2',
  BASE + 'assets/app.js' + V,
  BASE + 'assets/favicon.svg',
  BASE + 'assets/logo.png',
  BASE + 'assets/icon-192.png',
  BASE + 'assets/icon-512.png',
  // Chemin RELATIF à la portée : en sous-répertoire, « /manifest.json »
  // désigne la racine du domaine, où il n'existe pas.
  BASE + 'manifest.json'
];

self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(VERSION)
      // Une par une, et non `addAll` : celui-ci rejette en bloc dès qu'une
      // seule ressource manque. L'installation échouait alors entièrement,
      // l'ancien service worker restait aux commandes, et son cache périmé
      // avec lui — panne invisible et impossible à corriger côté poste.
      .then((cache) => Promise.all(
        STATIC_ASSETS.map((url) => cache.add(url).catch((erreur) => {
          console.warn('[merisu] ressource non mise en cache :', url, erreur);
        }))
      ))
      .then(() => self.skipWaiting())
  );
});

self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys()
      .then((keys) => Promise.all(keys.filter((k) => k !== VERSION).map((k) => caches.delete(k))))
      .then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', (event) => {
  const request = event.request;

  // Les écritures ne sont jamais servies depuis le cache ni rejouées ici.
  if (request.method !== 'GET') return;

  const url = new URL(request.url);
  if (url.origin !== self.location.origin) return;

  // pathname + search : les ressources versionnées portent « ?v=… », et
  // comparer le seul chemin ne les reconnaîtrait plus — elles sortiraient du
  // cache, et le poste perdrait son style et son script hors-ligne.
  if (STATIC_ASSETS.includes(url.pathname + url.search)) {
    event.respondWith(
      caches.match(request).then((cached) => cached || fetch(request))
    );
    return;
  }

  if (request.mode === 'navigate') {
    event.respondWith(
      fetch(request)
        .then((response) => {
          const copy = response.clone();
          caches.open(VERSION).then((cache) => cache.put(request, copy));
          return response;
        })
        .catch(() => caches.match(request).then((cached) => cached || caches.match(BASE)))
    );
  }
});
