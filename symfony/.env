# Valeurs par DÉFAUT, versionnées. Aucun secret ici.
#
# En production, créer `.env.local` (ignoré par git) qui surcharge ces valeurs :
#   APP_ENV=prod
#   APP_SECRET=<chaîne aléatoire>      → php -r 'echo bin2hex(random_bytes(24));'
#   DATABASE_URL=...
#
# `bin/deploy.sh` crée ce fichier automatiquement s'il est absent.

APP_ENV=dev
APP_SECRET=merisu-dev-secret-a-remplacer-en-production
# SQLite par défaut : démonstration sans installer de base.
# Production : DATABASE_URL="pgsql://user:pass@localhost:5432/merisu"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/merisu.sqlite"

# Codes PIN de DÉPART de l'équipe, à 6 chiffres. Ils ne sont lus qu'à la
# PREMIÈRE installation, pour créer les deux comptes de la boutique ; ensuite
# les codes se changent dans Admin ▸ Équipe et ne repassent plus par ici.
#
# ⚠️ CES DEUX CODES SONT PUBLIÉS DANS LE DÉPÔT, et ce sont des suites de
# chiffres : ils se devinent. À REMPLACER dans .env.local — ou, une fois
# l'application installée, dans Admin ▸ Équipe.
MERISU_ADMIN_PIN=123456
MERISU_CONSULTANT1_PIN=654321
# Utilisé par la seule implémentation de repli SANS base (LocalConsultantService),
# qui n'est plus branchée par défaut.
MERISU_CONSULTANT2_PIN=222222

# Affiche le rappel des codes sur l'écran de connexion. À passer à 0 en production.
MERISU_SHOW_DEMO_ACCOUNTS=1
